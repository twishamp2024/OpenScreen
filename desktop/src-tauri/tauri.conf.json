{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenScreen",
  "version": "0.1.0",
  "identifier": "io.github.openscreen.receiver",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenScreen",
        "width": 960,
        "height": 640,
        "minWidth": 560,
        "minHeight": 480,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,WebRtcHideLocalIpsWithMdns"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob: mediastream:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "OpenScreen contributors",
    "copyright": "Copyright (c) 2026 OpenScreen contributors. MIT License.",
    "category": "Utility",
    "shortDescription": "Wireless Android screen mirroring for Windows",
    "longDescription": "Open-source, view-only Android screen mirroring for Windows over local Wi-Fi.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/installer-hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}
